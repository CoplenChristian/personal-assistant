{
  "name": "personal-assistant-harness",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "personal-assistant-harness",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*",
        "cli/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "apps/dashboard": {
      "name": "@personal-assistant/dashboard",
      "version": "0.1.0"
    },
    "apps/server": {
      "name": "@personal-assistant/server",
      "version": "0.1.0"
    },
    "cli/pa": {
      "name": "@personal-assistant/pa",
      "version": "0.1.0",
      "bin": {
        "pa": "dist/index.js"
      }
    },
    "node_modules/@personal-assistant/capability-broker": {
      "resolved": "packages/capability-broker",
      "link": true
    },
    "node_modules/@personal-assistant/dashboard": {
      "resolved": "apps/dashboard",
      "link": true
    },
    "node_modules/@personal-assistant/harness": {
      "resolved": "packages/harness",
      "link": true
    },
    "node_modules/@personal-assistant/pa": {
      "resolved": "cli/pa",
      "link": true
    },
    "node_modules/@personal-assistant/runtime-adapters": {
      "resolved": "packages/runtime-adapters",
      "link": true
    },
    "node_modules/@personal-assistant/server": {
      "resolved": "apps/server",
      "link": true
    },
    "packages/capability-broker": {
      "name": "@personal-assistant/capability-broker",
      "version": "0.1.0"
    },
    "packages/harness": {
      "name": "@personal-assistant/harness",
      "version": "0.1.0"
    },
    "packages/runtime-adapters": {
      "name": "@personal-assistant/runtime-adapters",
      "version": "0.1.0"
    }
  }
}
