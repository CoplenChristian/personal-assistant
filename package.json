{
  "name": "personal-assistant-harness",
  "version": "0.1.0",
  "private": true,
  "description": "A thin local harness around native Claude Code and Codex runtimes.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "cli/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
